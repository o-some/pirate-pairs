---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const styleAsset = `${base}pirate-pairs.css`;
const scriptAsset = `${base}pirate-pairs.js`;

// Dropbox is the master/source of truth. Runtime mirrors are pinned to immutable
// GitHub commits so this standalone game cannot drift when sibling repos change.
const tulaSourceCommit = 'cf2fb9b3e2dc1eb885d50e88593124def1cbbdc0';
const tulaRoot = `https://raw.githubusercontent.com/o-some/tulasisland/${tulaSourceCommit}/assets/creative`;
const tulaNeutral = `${tulaRoot}/tula_neutral_front.webp`;
const tulaHappy = `${tulaRoot}/tula_happy.webp`;
const tulaSurprised = `${tulaRoot}/tula_surprised.webp`;
const tulaCelebrating = `${tulaRoot}/tula_celebrating.webp`;
const harborAsset = `${tulaRoot}/world_harbor.webp`;

const bossSourceCommit = '927afa882df75ab0c74c426d822af89767b5ec38';
const bossRoot = `https://raw.githubusercontent.com/o-some/word-guardians/${bossSourceCommit}/assets/bosses`;
const kaiAsset = `${bossRoot}/boss-01-pirat-kai.png`;
const braxAsset = `${bossRoot}/boss-02-kapitaen-brax.png`;
const blackfinnAsset = `${bossRoot}/boss-03-blackfinn.png`;

const tulaFallback = `${base}assets/tula.svg`;
const kaiFallback = `${base}assets/kai.svg`;

const gameConfig = {
  sourceLanguage: 'de',
  targetLanguage: 'en',
  sourceLabel: 'DE',
  targetLabel: 'EN',
  vocabulary: [
    { id: 'ship', source: 'Schiff', target: 'ship', category: 'alltag' },
    { id: 'island', source: 'Insel', target: 'island', category: 'alltag' },
    { id: 'sun', source: 'Sonne', target: 'sun', category: 'alltag' },
    { id: 'water', source: 'Wasser', target: 'water', category: 'alltag' },
    { id: 'apple', source: 'Apfel', target: 'apple', category: 'alltag' },
    { id: 'dog', source: 'Hund', target: 'dog', category: 'alltag' },
    { id: 'house', source: 'Haus', target: 'house', category: 'alltag' },
    { id: 'bread', source: 'Brot', target: 'bread', category: 'alltag' },
  ],
};

const bossConfig = {
  startBossId: 1,
  bosses: [
    {
      bossId: 1,
      name: 'Pirat Kai',
      shortName: 'KAI',
      image: kaiAsset,
      location: 'WÖRTERBUCHT',
      memoryStrength: 0.61,
      forgetChance: 0.12,
      thinkingDelay: 720,
      introTitle: 'Er verschiebt, was du dir merkst.',
      introCopy: 'Finde die passenden <b>Deutsch ↔ Englisch</b>-Paare. Kai tauscht im Kampf zwei verdeckte Karten sichtbar miteinander – ohne sie aufzudecken.',
      ability: {
        type: 'swap',
        name: 'Decktausch',
        description: 'Alle drei deiner Versuche tauscht Kai zwei verdeckte Karten sichtbar miteinander. Folge der Bewegung genau.',
        everyPlayerAttempts: 3,
      },
    },
    {
      bossId: 2,
      name: 'Kapitän Brax',
      shortName: 'BRAX',
      image: braxAsset,
      location: 'PULVERKAI',
      memoryStrength: 0.67,
      forgetChance: 0.10,
      thinkingDelay: 690,
      introTitle: 'Brax spielt mit Feuer.',
      introCopy: 'Brax legt Bomben unter verdeckte Karten. Du siehst, welche Karte vermint wird. Öffnest du sie trotzdem, verlierst du einen Punkt und Brax bekommt einen.',
      ability: {
        type: 'bomb',
        name: 'Pulverfalle',
        description: 'Alle drei deiner Versuche vermint Brax eine sichtbare Kartenposition für zwei Versuche: Treffer = −1 Punkt für dich, +1 für Brax.',
        everyPlayerAttempts: 3,
      },
    },
    {
      bossId: 3,
      name: 'Blackfinn',
      shortName: 'BLACKFINN',
      image: blackfinnAsset,
      location: 'NEBELRIFF',
      memoryStrength: 0.72,
      forgetChance: 0.09,
      thinkingDelay: 660,
      introTitle: 'Blackfinn nimmt dir die Sicht.',
      introCopy: 'Blackfinn ruft dichten Nebel über Teile des Decks. Die betroffenen Karten bleiben sichtbar an ihrem Platz, sind für deinen nächsten Versuch aber gesperrt.',
      ability: {
        type: 'fog',
        name: 'Nebelwand',
        description: 'Alle zwei deiner Versuche blockiert Blackfinn bis zu drei verdeckte Karten für deinen nächsten Versuch. Er selbst kann sie weiterhin nutzen.',
        everyPlayerAttempts: 2,
      },
    },
  ],
};
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no" />
  <meta name="theme-color" content="#041c2e" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>Pirate Pairs · Tula’s Island</title>
  <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin="anonymous" />
  <link rel="preload" as="image" href={tulaNeutral} crossorigin="anonymous" />
  <link rel="preload" as="image" href={kaiAsset} crossorigin="anonymous" />
  <link rel="preload" as="image" href={harborAsset} crossorigin="anonymous" />
  <link rel="stylesheet" href={styleAsset} />
  <link rel="stylesheet" href={`${base}pirate-pairs-polish-v2.css`} />
  <link rel="stylesheet" href={`${base}pirate-pairs-compact-v5.css`} />
  <link rel="stylesheet" href={`${base}pirate-pairs-card-emblem.css`} />
  <link rel="stylesheet" href={`${base}pirate-pairs-bosses.css`} />
</head>
<body style={`--pp-harbor:url("${harborAsset}")`}>
  <div class="app" id="app">
    <header class="topbar">
      <button class="round" id="helpBtn" aria-label="Spielregeln">?</button>
      <div class="logo"><b>PIRATE PAIRS</b><small>TULA’S ISLAND · MEMORY DUEL</small></div>
      <button class="round" id="restartBtn" aria-label="Neu starten">↻</button>
    </header>

    <section class="duel" aria-label="Duellstand">
      <div class="fighter">
        <div class="portrait tula-portrait">
          <img id="tulaDuelSprite" class="character-sprite tula-sprite" src={tulaNeutral} alt="Tula"
            data-neutral={tulaNeutral} data-happy={tulaHappy} data-surprised={tulaSurprised}
            data-celebrating={tulaCelebrating} data-fallback={tulaFallback} decoding="async" />
        </div>
        <div class="fighter-copy"><small>DU</small><b>TULA</b><div class="score"><strong id="playerScore">0</strong><span>PUNKTE</span></div></div>
      </div>
      <div class="turn"><small>AM ZUG</small><b id="turnPill">DU BIST DRAN</b></div>
      <div class="fighter enemy">
        <div class="fighter-copy"><small>GEGNER</small><b id="bossName">PIRAT KAI</b><div class="score"><strong id="aiScore">0</strong><span>PUNKTE</span></div></div>
        <div class="portrait kai-portrait"><img id="bossDuelSprite" class="character-sprite kai-sprite" src={kaiAsset} data-fallback={kaiFallback} alt="Pirat Kai" decoding="async" /></div>
      </div>
    </section>

    <main class="arena">
      <div class="arena-head">
        <div class="level-tag" id="levelTag"><span>☠</span> LEVEL 1 · WÖRTERBUCHT</div>
        <div class="progress">PAARE GEFUNDEN <b id="progress">0 / 8</b></div>
      </div>
      <div class="boss-ability-banner" id="bossAbilityBanner" aria-live="assertive" aria-atomic="true">
        <b id="bossAbilityTitle">BOSS-TRICK</b>
        <span id="bossAbilityCopy"></span>
      </div>
      <div class="grid" id="grid" aria-label="Memory Spielfeld"></div>
      <section class="skillbar">
        <div class="skill-copy"><small>TULAS FÄHIGKEIT</small><b>🐚 Muschelblick</b><span>Zeigt dir kurz zwei verdeckte Karten.</span></div>
        <button class="skill" id="peekBtn">1× EINSETZEN</button>
      </section>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <section class="overlay" id="intro">
    <div class="modal">
      <div class="mini-logo">PIRATE PAIRS<small>TULA’S ISLAND</small></div>
      <div class="versus">
        <img class="tula intro-tula" src={tulaNeutral} data-fallback={tulaFallback} alt="Tula" />
        <span class="vs">VS</span>
        <img id="introBossSprite" class="kai" src={kaiAsset} data-fallback={kaiFallback} alt="Pirat Kai" />
      </div>
      <span class="boss-tag" id="introBossTag">☠ LEVEL 1 · PIRAT KAI</span>
      <h1 id="introTitle">Er verschiebt, was du dir merkst.</h1>
      <p id="introCopy">Finde die passenden <b>Deutsch ↔ Englisch</b>-Paare und besiege Pirat Kai.</p>
      <div class="boss-power"><small>BOSS-TRICK</small><b id="bossPowerName">Decktausch</b><span id="bossPowerCopy">Kai tauscht verdeckte Karten sichtbar miteinander.</span></div>
      <div class="rules"><div class="rule"><b>1. MERKEN</b>Karten aufdecken</div><div class="rule"><b>2. LERNEN</b>Übersetzung finden</div><div class="rule"><b>3. DUELLIEREN</b>Mehr Punkte sammeln</div></div>
      <button class="cta" id="startBtn">⚔ MEMORY-DUELL STARTEN</button>
      <span class="modal-note" id="introModalNote">DE → EN · 8 LERNPAARE · BOSS 1</span>
    </div>
  </section>

  <section class="overlay hidden" id="result">
    <div class="modal">
      <div class="mini-logo">PIRATE PAIRS<small>DUELL BEENDET</small></div>
      <div class="versus">
        <img id="resultTulaSprite" class="tula result-tula" src={tulaNeutral} alt="Tula"
          data-neutral={tulaNeutral} data-happy={tulaHappy} data-surprised={tulaSurprised}
          data-celebrating={tulaCelebrating} data-fallback={tulaFallback} />
        <span class="vs">VS</span>
        <img id="resultBossSprite" class="kai" src={kaiAsset} data-fallback={kaiFallback} alt="Pirat Kai" />
      </div>
      <span class="boss-tag" id="resultTag">LEVEL 1</span>
      <h2 id="resultTitle">Du hast gewonnen!</h2>
      <p id="resultCopy">Pirat Kai muss die Wörterbucht räumen.</p>
      <div class="result-stats"><div class="result-stat"><b id="resultPlayer">0</b><small>DEINE PUNKTE</small></div><div class="result-stat"><b id="resultShells">+0</b><small>MUSCHELN</small></div><div class="result-stat"><b id="resultXp">+0</b><small>XP</small></div></div>
      <button class="cta" id="againBtn">↻ NOCH EIN DUELL</button>
      <span class="modal-note" id="resultModalNote">NÄCHSTE ETAPPE: KAPITÄN BRAX</span>
    </div>
  </section>

  <section class="help hidden" id="help">
    <div class="help-card">
      <h3>So funktioniert Pirate Pairs</h3>
      <p>Du deckst zwei Karten auf. Nur eine deutsche Karte und ihre englische Übersetzung bilden ein Paar. Ein gefundenes Paar bringt einen Punkt.</p>
      <p>Jeder Boss hat einen eigenen Trick. Die Fähigkeit wird sichtbar angekündigt, damit du reagieren und taktisch spielen kannst. Bomben- und spätere Bonusmechaniken können den Punktestand zusätzlich verändern.</p>
      <p><b>Muschelblick:</b> Einmal pro Runde darf Tula zwei zufällige verfügbare Karten kurz aufdecken.</p>
      <button id="closeHelp">VERSTANDEN</button>
    </div>
  </section>

  <script id="game-data" type="application/json" set:html={JSON.stringify(gameConfig)}></script>
  <script id="boss-data" type="application/json" set:html={JSON.stringify(bossConfig)}></script>
  <script src={scriptAsset} defer></script>
  <script src={`${base}pirate-pairs-fx-v2.js`} defer></script>
</body>
</html>
