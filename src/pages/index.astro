---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const tulaAsset = `${base}assets/tula.svg`;
const kaiAsset = `${base}assets/kai.svg`;
const styleAsset = `${base}pirate-pairs.css`;
const scriptAsset = `${base}pirate-pairs.js`;

const gameConfig = {
  sourceLanguage: 'de',
  targetLanguage: 'en',
  sourceLabel: 'DE',
  targetLabel: 'EN',
  vocabulary: [
    { id: 'ship', source: 'Schiff', target: 'ship', category: 'alltag' },
    { id: 'island', source: 'Insel', target: 'island', category: 'alltag' },
    { id: 'sun', source: 'Sonne', target: 'sun', category: 'alltag' },
    { id: 'water', source: 'Wasser', target: 'water', category: 'alltag' },
    { id: 'apple', source: 'Apfel', target: 'apple', category: 'alltag' },
    { id: 'dog', source: 'Hund', target: 'dog', category: 'alltag' },
    { id: 'house', source: 'Haus', target: 'house', category: 'alltag' },
    { id: 'bread', source: 'Brot', target: 'bread', category: 'alltag' },
  ],
};

const bossConfig = {
  bossId: 1,
  name: 'Pirat Kai',
  memoryStrength: 0.61,
  forgetChance: 0.12,
  thinkingDelay: 720,
  specialAbility: null,
};
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no" />
  <meta name="theme-color" content="#062a48" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>Pirate Pairs · Tula’s Island</title>
  <link rel="stylesheet" href={styleAsset} />
</head>
<body>
  <div class="app" id="app">
    <header class="topbar">
      <button class="round" id="helpBtn" aria-label="Spielregeln">?</button>
      <div class="logo"><b>PIRATE PAIRS</b><small>TULA’S ISLAND · MEMORY DUEL</small></div>
      <button class="round" id="restartBtn" aria-label="Neu starten">↻</button>
    </header>

    <section class="duel" aria-label="Duellstand">
      <div class="fighter">
        <div class="portrait"><img src={tulaAsset} alt="Tula" /></div>
        <div class="fighter-copy"><small>DU</small><b>TULA</b><div class="score"><strong id="playerScore">0</strong><span>/ 8 PAARE</span></div></div>
      </div>
      <div class="turn"><small>AM ZUG</small><b id="turnPill">DU BIST DRAN</b></div>
      <div class="fighter enemy">
        <div class="fighter-copy"><small>GEGNER</small><b>PIRAT KAI</b><div class="score"><strong id="aiScore">0</strong><span>/ 8 PAARE</span></div></div>
        <div class="portrait"><img src={kaiAsset} alt="Pirat Kai" /></div>
      </div>
    </section>

    <main class="arena">
      <div class="arena-head">
        <div class="level-tag"><span>☠</span> LEVEL 1 · WÖRTERBUCHT</div>
        <div class="progress">PAARE GEFUNDEN <b id="progress">0 / 8</b></div>
      </div>
      <div class="grid" id="grid" aria-label="Memory Spielfeld"></div>
      <section class="skillbar">
        <div class="skill-copy"><small>TULAS FÄHIGKEIT</small><b>🐚 Muschelblick</b><span>Zeigt dir kurz zwei verdeckte Karten.</span></div>
        <button class="skill" id="peekBtn">1× EINSETZEN</button>
      </section>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <section class="overlay" id="intro">
    <div class="modal">
      <div class="mini-logo">PIRATE PAIRS<small>TULA’S ISLAND</small></div>
      <div class="versus"><img src={tulaAsset} alt="Tula" /><span class="vs">VS</span><img class="kai" src={kaiAsset} alt="Pirat Kai" /></div>
      <span class="boss-tag">☠ LEVEL 1 · PIRAT KAI</span>
      <h1>Er klaut deine Wörter.</h1>
      <p>Finde die passenden <b>Deutsch ↔ Englisch</b>-Paare, bevor Kai sie sich schnappt. Wer ein Paar findet, darf direkt noch einmal.</p>
      <div class="rules"><div class="rule"><b>1. MERKEN</b>Karten aufdecken</div><div class="rule"><b>2. LERNEN</b>Übersetzung finden</div><div class="rule"><b>3. DUELLIEREN</b>Mehr Paare sammeln</div></div>
      <button class="cta" id="startBtn">⚔ MEMORY-DUELL STARTEN</button>
      <span class="modal-note">PROTOTYP · DE → EN · 8 LERNPAARE</span>
    </div>
  </section>

  <section class="overlay hidden" id="result">
    <div class="modal">
      <div class="mini-logo">PIRATE PAIRS<small>DUELL BEENDET</small></div>
      <div class="versus"><img src={tulaAsset} alt="Tula" /><span class="vs">VS</span><img class="kai" src={kaiAsset} alt="Pirat Kai" /></div>
      <span class="boss-tag" id="resultTag">LEVEL 1</span>
      <h2 id="resultTitle">Du hast gewonnen!</h2>
      <p id="resultCopy">Pirat Kai muss die Wörterbucht räumen.</p>
      <div class="result-stats"><div class="result-stat"><b id="resultPlayer">0</b><small>DEINE PAARE</small></div><div class="result-stat"><b id="resultShells">+0</b><small>MUSCHELN</small></div><div class="result-stat"><b id="resultXp">+0</b><small>XP</small></div></div>
      <button class="cta" id="againBtn">↻ NOCH EIN DUELL</button>
      <span class="modal-note">NÄCHSTE VERSION: BOSSE · KATEGORIEN · SCHWIERIGKEIT</span>
    </div>
  </section>

  <section class="help hidden" id="help">
    <div class="help-card">
      <h3>So funktioniert Pirate Pairs</h3>
      <p>Du deckst zwei Karten auf. Nur eine deutsche Karte und ihre englische Übersetzung bilden ein Paar. Bei einem Treffer behältst du das Paar und spielst weiter.</p>
      <p>Kai beobachtet dieselben Karten und merkt sich einige Positionen. Sein Gedächtnis ist auf Level 1 absichtlich nicht perfekt; spätere Bosse können deutlich schlauer werden.</p>
      <p><b>Muschelblick:</b> Einmal pro Runde darf Tula zwei zufällige verdeckte Karten kurz aufdecken.</p>
      <button id="closeHelp">VERSTANDEN</button>
    </div>
  </section>

  <script id="game-data" type="application/json" set:html={JSON.stringify(gameConfig)}></script>
  <script id="boss-data" type="application/json" set:html={JSON.stringify(bossConfig)}></script>
  <script src={scriptAsset} defer></script>
</body>
</html>
